[35.993313, "o", "\u001b[1;25H\u001b[38;5;6;49m┌ src/app/refresh.rs ────────────────────────────────────────────────────────────────────────┐\u001b[2;25H│\u001b[2;118H│\u001b[3;25H│\u001b[3;118H│\u001b[4;25H│\u001b[4;118H│\u001b[5;18H\u001b[39;49m_te...\u001b[38;5;8;49m│\u001b[38;5;6;49m│\u001b[39;49m \u001b[38;5;8;49m   4 \u001b[38;2;101;115;126;49m//! event-based updates: draining completed background loads, reloadin\u001b[5;118H\u001b[38;5;6;49m│\u001b[6;18H\u001b[39;49m.rs   \u001b[38;5;8;49m│\u001b[38;5;6;49m│\u001b[39;49m \u001b[38;5;8;49m   5 \u001b[38;2;101;115;126;49m//! file when its watcher fires, advancing the debounced content searc\u001b[6;118H\u001b[38;5;6;49m│\u001b[7;18H\u001b[39;49m_te...\u001b[38;5;8;49m│\u001b[38;5;6;49m│\u001b[39;49m \u001b[38;5;8;49m   6 \u001b[38;2;101;115;126;49m//! refreshing the tree/git state. Tree refreshes are event-driven whe\u001b[7;118H\u001b[38;5;6;49m│\u001b[8;18H\u001b[39;49m      \u001b[38;5;8;49m│\u001b[38;5;6;49m│\u001b[39;49m \u001b[38;5;8;49m   7 \u001b[38;2;101;115;126;49m//! filesystem watcher is installed (reloading only after events go qu\u001b[8;118H\u001b[38;5;6;49m│\u001b[9;18H\u001b[39;49mt.\u001b[9;21Hs  \u001b[38;5;8;49m│\u001b[38;5;6;49m│\u001b[39;49m \u001b[38;5;8;49m   8 \u001b[38;2;101;115;126;49m//! `TREE_RELOAD_DEBOUNCE`, to coalesce bursts), with a periodic timer\u001b[9;118H\u001b[38;5;6;49m│\u001b[10;18H\u001b[39;49m      \u001b[38;5;8;49m│\u001b[38;5;6;49m│\u001b[39;49m \u001b[38;5;8;49m   9 \u001b[38;2;101;115;126;49m//! when no watcher could be installed so the view never goes permanen\u001b[10;118H\u001b[38;5;6;49m│\u001b[11;18H\u001b[39;49mt.\u001b[11;21Hs  \u001b[38;5;8;49m│\u001b[38;5;6;49m│\u001b[39;49m \u001b[38;5;8;49m  10 \u001b[38;2;101;115;126;49m//! Config-file (`mantis.toml`) changes follow the same debounce befor\u001b[11;118H\u001b[38;5;6;49m│\u001b[12;18H\u001b[39;49m \u001b[12;24H\u001b[38;5;8;49m│\u001b[38;5;6;49m│\u001b[12;27H\u001b[38;5;8;49m  11 \u001b[38;2;101;115;126