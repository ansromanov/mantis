[20.256607, "o", "115;126;49m//! when no watcher could be installed so the view never goes permanently stale.\u001b[11;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[11;10H\u001b[22m\u001b[39;49minit_test.\u001b[11;21Hs  \u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m  10 \u001b[38;2;101;115;126;49m//! Config-file (`mantis.toml`) changes follow the same debounce before\u001b[12;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[22m\u001b[39;49m  lint.rs\u001b[12;18H      \u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m  11 \u001b[38;2;101;115;126;49m//! `handle_config_change` runs, so an editor's atomic save doesn't trigger\u001b[13;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[22m\u001b[39;49m \u001b[13;10Hlint_test.\u001b[13;21Hs  \u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m  12 \u001b[38;2;101;115;126;49m//! more than one reload.\u001b[13;101H\u001b[39;49m \u001b[14;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[22m\u001b[39;49m  loader.rs     \u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m  13 \u001b[39;49m                      \u001b[14;101H \u001b[15;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[22m\u001b[39;49m  loader_te\u001b[15;20Ht.rs\u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m  14 \u001b[38;2;180;142;173;49muse\u001b[38;2;192;197;206;49m std::time::Duration;\u001b[15;101H\u001b[39;49m   \u001b[15;105H   \u001b[16;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[22m\u001b[39;49m  markdown_vi...\u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m  15 \u001b[39;49m        \u001b[16;101H \u001b[17;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[22m\u001b[39;49m  mar\u001b[17;14Hdown_vi...\u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m  16 \u001b[38;2;180;142;173;49muse\u001b[38;2;192;197;206;49m \u001b[38;2;180;142;173;49msuper\u001b[38;2;192;