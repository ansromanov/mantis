[20.256555, "o", "\u001b[1;1H\u001b[38;5;6;49m┌ Files ───────────────┐\u001b[1;27H\u001b[38;5;8;49msrc/app/refresh.rs \u001b[2;1H\u001b[38;5;6;49m│\u001b[2;24H│\u001b[2;26H\u001b[38;5;6;48;2;58;90;90m    1 \u001b[38;2;101;115;126;48;2;58;90;90m//! Per-frame update tick for `App`.\u001b[39;48;2;58;90;90m                                                  \u001b[3;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[22m\u001b[39;49m  context_men...\u001b[38;5;6;49m│\u001b[3;27H\u001b[38;5;8;49m   2 \u001b[38;2;101;115;126;49m//!\u001b[4;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[22m\u001b[39;49m  diff_nav.rs\u001b[4;24H\u001b[38;5;6;49m│\u001b[4;26H\u001b[39;49m \u001b[38;5;8;49m   3 \u001b[38;2;101;115;126;49m//! `tick` runs once per render-loop iteration and drives all time- and\u001b[5;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[22m\u001b[39;49m  diff_nav_te...\u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m   4 \u001b[38;2;101;115;126;49m//! event-based updates: draining completed background loads, reloading an open\u001b[6;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[6;10H\u001b[22m\u001b[39;49mfile_ops.rs   \u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m   5 \u001b[38;2;101;115;126;49m//! file when its watcher fires, advancing the debounced content search, and\u001b[39;49m   \u001b[6;112H    \u001b[7;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[7;10H\u001b[22m\u001b[39;49mfile_ops_te...\u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m   6 \u001b[38;2;101;115;126;49m//! refreshing the tree/git state. Tree refreshes are event-driven when the root\u001b[8;1H\u001b[38;5;6;49m│\u001b[2m\u001b[38;5;8;49m│  │  \u001b[8;10H\u001b[22m\u001b[39;49mfold.rs\u001b[8;18H      \u001b[38;5;6;49m│\u001b[38;5;8;49m│\u001b[39;49m \u001b[38;5;8;49m   7 \u001b[38;2;101;115;126;49m//! filesystem watcher is installed (reloading only after events go quiet for\u001b[9;