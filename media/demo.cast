[15.242387, "o", "\u001b[2;26Heven in\u001b[2;34Ha\u001b[2;36Hterminal.\u001b[3;27H                        \u001b[4;26H\u001b[1m\u001b[38;2;0;255;0;49mHeading Level 3\u001b[5;27H\u001b[22m\u001b[39;49m                                                                               \u001b[6;26HThird-level headings are good for sub-topics within a section,\u001b[6;89Hsuch\u001b[6;94Has\u001b[6;97Hthe\u001b[6;101Hindividual\u001b[6;112Hlist\u001b[7;26Hflavors\u001b[7;34Hshown\u001b[7;40Hlater\u001b[7;46Hin\u001b[7;49Hthis\u001b[7;54Hdocument.\u001b[8;27H                         \u001b[9;26H\u001b[1m\u001b[38;2;255;255;255;49mHeading Level 4\u001b[22m\u001b[39;49m            \u001b[10;27H                           \u001b[11;26H\u001b[1m\u001b[38;2;255;255;255;49mHeading Level 5\u001b[12;27H\u001b[22m\u001b[39;49m                                                                                   \u001b[13;26H\u001b[1m\u001b[38;2;255;255;255;49mHeading Level 6\u001b[22m\u001b[39;49m                                    \u001b[14;27H     \u001b[15;26HLevels four through six\u001b[15;50Hshare\u001b[15;56Ha\u001b[15;58Hstyle\u001b[15;64Hhere,\u001b[15;70Hbut\u001b[15;74Hthey\u001b[15;79Hstill\u001b[15;85Hcreate\u001b[15;92Hstructure\u001b[15;102Hin\u001b[15;105Hthe\u001b[16;26Hunderlying\u001b[16;37Houtline\u001b[16;45Hand\u001b[16;49Hin\u001b[16;52Hthe\u001b[16;56Hraw\u001b[16;60Hsource.\u001b[17;27H                                                                                   \u001b[18;26H\u001b[1m\u001b[38;2;255;255;0;49mText Styling\u001b[22m\u001b[39;49m                                                                \u001b[19;27H                                                                                    \u001b[20;26HProse carries most of a document’s meaning, so inline styling matters. You can write\u001b[20;111H\u001b[1mbold \u001b[21;26Htext\u001b[22m for emphasis,\u001b[21;45H\u001b[3mitalic text\u001b[21;57H\u001b[23mfor\u001b[21;61Hsubtle\u001b[21;68Hstress,\u001b[21;76Hand\u001b[21;80H\u001b[1m\u001b[3mbold and italic\u001b[21;96H\u001b[22m\u001b[23mwhen\u001b[21;101Hyou\u001b[21;105Hneed\u001b[21;110Hboth\u001b[21;115Hat\u001b[22;26Honce. Use\u001b[22;36H\u001b[9mstrikethrough\u001b[22;50H\u001b[29mto\u001b[22;53Hshow\u001b[22;58Hremoved\u001b[22;66Hor\u001b[22;69Houtdated\u001b[22;78Hcontent,\u001b[22;87Hand\u001b[22;91H\u001b[38;2;255;255;0;49m`inline code spans`\u001b[22;111H\u001b[39;49mfor\u001b[23;26Hidentifiers, file names like \u001b[38;2;255;255;0;49m`src/config.rs`\u001b[39;49m, or short commands such as \u001b[38;2;255;255;0;49m`cargo build`\u001b[39;49m.\u001b[24;27H                                                                                \u001b[25;26HStyles nest and combine, so a phrase like \u001b[1m\u001b[3mbold italic wrapping \u001b[22m\u001b[23m\u001b[38;2;255;255;0;49m`inline code`\u001b[25;103H\u001b[39;49mrenders\u001b[25;111Hevery\u001b[26;26Hmodifier\u001b[26;35Htogether.\u001b[26;45HThis\u001b[26;50His\u001b[26;53Hhandy\u001b[26;59Hwhen\u001b[26;64Hdocumenting\u001b[26;76Han\u001b[26;79HAPI\u001b[26;83Hwhere\u001b[26;89Ha\u001b[26;91Hterm\u001b[26;96His\u001b[26;99Hboth\u001b[26;104Himportant\u001b[26;114Hand\u001b[27;26Ha literal symbol.                    \u001b[28;27H                                                                            \u001b[29;26HA soft line break in the source continues on the same\u001b[29;80Hrendered\u001b[29;89Hline,\u001b[29;95Hwhich\u001b[29;101Hkeeps\u001b[29;107Hparagraphs\u001b[30;26Hreflowable. A hard break, made with two trailing spaces,                            \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l\u001b[?2026l"]
